{
  "name": "options-chart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @options-chart/web",
    "build": "npm run build:packages && npm run build --workspace @options-chart/web",
    "build:packages": "tsc -b packages/domain packages/shared packages/market-data packages/options-engine packages/worker-protocol packages/chart",
    "lint": "eslint apps/web/app apps/web/next.config.ts apps/web/next-env.d.ts packages tests scripts tools eslint.config.mjs playwright.config.ts vitest.config.ts",
    "typecheck": "tsc -b packages/domain packages/shared packages/market-data packages/options-engine packages/worker-protocol packages/chart && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "benchmark:deribit": "node scripts/benchmark-deribit.mts",
    "benchmark:engine": "tsx scripts/benchmark-options-engine.mts",
    "capture:deribit": "tsx tools/capture-fixtures/capture-deribit.ts",
    "verify:parity": "tsx scripts/verify-parity.ts",
    "test:parity": "tsx scripts/verify-parity.ts",
    "test:python": "python tools/reference-python/test_black_scholes.py && python tools/reference-python/test_gamma_reference.py && python tools/reference-python/test_max_pain.py",
    "verify:deribit-live": "vitest run --config vitest.live.config.ts",
    "format:check": "prettier --check .",
    "progress:build": "node scripts/progress.mjs build",
    "progress:check": "node scripts/progress.mjs check",
    "progress:policy": "node scripts/progress.mjs policy"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
