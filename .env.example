# Auth.js / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Exact email address permitted to access production.
AUTH_ALLOWLIST_EMAIL=

# Development only. Set false to exercise the sign-in gate locally.
AUTH_DEV_BYPASS=true

# M11.6 Jev shadow provider. For local Next.js development, copy these values
# into apps/web/.env.local. Keep the provider disabled and killed until the
# server checkpoint has passed its local validation.
TYPESAFE_API_KEY=
JEV_SHADOW_ENABLED=false
JEV_KILL_SWITCH=true
JEV_MODEL=jev-latest
JEV_AUDIT_DIR=.data/jev-audit
JEV_TIMEOUT_MS=2000
JEV_MAX_CALLS_PER_HOUR=12
JEV_MAX_CALLS_PER_DAY=50
JEV_MAX_REQUEST_BYTES=65536
